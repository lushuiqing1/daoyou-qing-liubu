; Native Godot port. No browser runtime or web save migration.
config_version=5

[application]
config/name="道友请留步 · 水墨仙途"
config/version="godot-1.5.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/app-icon-512.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="DaoyouGodotInk"

[display]
window/size/viewport_width=430
window/size/viewport_height=844
window/size/window_width_override=430
window/size/window_height_override=844
window/size/resizable=true
window/stretch/mode="disabled"
window/handheld/orientation=6

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.14, 0.21, 0.19, 1)
